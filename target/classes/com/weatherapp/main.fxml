               </image>
            </ImageView>
         </graphic>
        <items>
            <MenuItem fx:id="mnuDefault" text="Default (Kelvin)" onAction="#handleDefaultSystem" />
            <MenuItem fx:id="mnuMetric" text="Metric (Celsius)" onAction="#handleMetricSystem" />
            <MenuItem fx:id="mnuImperial" text="Imperial (Fahrenheit)" onAction="#handleImperialSystem" />
